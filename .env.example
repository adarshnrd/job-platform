# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── AI (set at least one) ───────────────────────────────────────────────────
# Groq (free tier — recommended for most tasks)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (free credits — secondary provider for double-evaluation)
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Anthropic (optional — for high-quality reasoning tasks)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Job-source aggregator APIs (OPTIONAL — sources auto-skip if unset) ──────
# Adzuna (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (free): https://jooble.org/api/about
JOOBLE_API_KEY=
# JSearch via RapidAPI (freemium): Google-for-Jobs aggregator
JSEARCH_RAPIDAPI_KEY=

# ─── HR-contact enrichment (OPTIONAL) ────────────────────────────────────────
# Adds a hiring contact to each job. With NO key set, every job still gets a
# keyless LinkedIn people-search link. Add a provider key to light up VERIFIED
# email / LinkedIn (hr_email is never guessed — providers only). Set any one:
#   Hunter.io (free tier)   https://hunter.io/api-keys
HUNTER_API_KEY=
#   Apollo.io (email+LinkedIn)  https://apolloio.github.io/apollo-api-docs/
APOLLO_API_KEY=
#   Proxycurl (LinkedIn URL)  https://nubela.co/proxycurl
PROXYCURL_API_KEY=
# Set to false to disable enrichment entirely (default: true)
# HR_CONTACT_ENRICHMENT_ENABLED=true

# ─── Email (Resend — optional) ───────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Session Encryption ─────────────────────────────────────────────────────
# REQUIRED — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=GENERATE_A_REAL_KEY
SESSION_ENCRYPTION_KEY_VERSION=1

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=true
